# LLM endpoint config — OpenAI-compatible client, backend is config not code.
#
# Option A (dev default): Gemini API, free tier (15 RPM)
#   Get a key at https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemma-4-26b-a4b-it
# LLM_API_KEY=

# Option B (HF router / Cerebras, matches cerebras_serving.py): pin a provider
# suffix rather than :auto to avoid per-provider image-handling quirks.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=google/gemma-4-31B-it:cerebras
LLM_API_KEY=

# Alternatively set HF_TOKEN and leave LLM_API_KEY unset — coach_llm.py falls
# back to HF_TOKEN when LLM_API_KEY is empty and LLM_BASE_URL points at the
# HF router.
HF_TOKEN=
